{
  "name": "autorest-dsh-plugin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AutoREST: AI-Driven REST Electronic Structure Automation — DSH Plugin",
  "main": "./lib/index.js",
  "engines": { "node": ">=18" },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "autorest": {
    "compatibility": {
      "dslVersionTested": ["current"]
    },
    "channel": "community",
    "targets": ["universal"]
  },
  "license": "MIT"
}